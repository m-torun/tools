<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>local.claude-rc-update</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/mustafa/code/tools/claude-rc/claude-rc</string>
		<string>update</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
		<key>HOMEBREW_NO_ENV_HINTS</key>
		<string>1</string>
	</dict>
	<!-- Daily at 04:00, when no session should be in use: a restart ends open sessions.
	     If the Mac is asleep then, launchd runs it on wake. -->
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>4</integer>
		<key>Minute</key>
		<integer>0</integer>
	</dict>
	<key>StandardOutPath</key>
	<string>/Users/mustafa/Library/Logs/claude-rc.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/mustafa/Library/Logs/claude-rc.log</string>
</dict>
</plist>
