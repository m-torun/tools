#!/bin/bash
# Runs Claude Code's Remote Control host, and updates Claude Code at night.
#
#   claude-rc          start the host (launchd runs this)
#   claude-rc update   upgrade Claude Code with Homebrew and restart the host on it
#
# Remote Control starts every new session from its own binary's path, and
# Homebrew deletes the old version's folder when it upgrades Claude Code. A host
# that outlives an upgrade can no longer start sessions. So upgrades happen only
# here, followed at once by a restart; Claude Code's own background upgrade is
# off (CLAUDE_CODE_PACKAGE_MANAGER_AUTO_UPDATE in ~/.claude/settings.json).
#
# A copy of the binary outside Homebrew would avoid the restart, but a copy
# cannot read Claude Code's login from the keychain: it hangs at startup.
set -euo pipefail

BREW_CLAUDE=/opt/homebrew/bin/claude
CASK=claude-code@latest
LABEL=local.claude-rc
WORKDIR="$HOME/code"

stamp() { date '+%F %T'; }
version_of() { "$1" --version 2>/dev/null | awk '{print $1}'; }

start() {
    local binary
    binary=$(realpath "$BREW_CLAUDE")
    echo "$(stamp) starting Remote Control with Claude Code $(version_of "$binary")"
    cd "$WORKDIR"
    exec "$binary" remote-control
}

# The binary the running host was started from, or nothing.
running_binary() {
    local pid
    pid=$(launchctl print "gui/$(id -u)/$LABEL" 2>/dev/null | awk '$1 == "pid" {print $3}')
    [ -n "$pid" ] || return 0
    ps -o command= -p "$pid" | sed -n 's| remote-control$||p'
}

update() {
    echo "$(stamp) brew upgrade --cask $CASK"
    brew upgrade --cask "$CASK" || echo "$(stamp) brew upgrade failed; checking the host anyway"
    local current running
    current=$(realpath "$BREW_CLAUDE")
    running=$(running_binary)
    if [ "$current" != "$running" ]; then
        echo "$(stamp) restarting Remote Control: ${running:-not running} -> $current"
        launchctl kickstart -k "gui/$(id -u)/$LABEL"
    fi
}

case "${1:-}" in
    "") start ;;
    update) update ;;
    *) echo "usage: claude-rc [update]" >&2; exit 2 ;;
esac
